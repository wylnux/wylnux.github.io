-- 3. CREAR TABLA DE TAREAS / ENTRADAS DE LA BITÁCORA
CREATE TABLE IF NOT EXISTS public.tareas (
    id bigint generated by default as identity not null,
    texto text not null,
    descripcion text null,
    area text null,
    familia text null,
    equipo text null,
    estado text default 'pendiente', -- 'pendiente', 'en_proceso', 'realizado'
    realizado_por text null,
    comentario text null,
    fecha_realizacion timestamp with time zone null,
    mes_periodo text null, -- Almacena el formato 'YYYY-MM' para el control mensual
    created_at timestamp with time zone default timezone('utc'::text, now()) not null,
    constraint tareas_pkey primary key (id)
);


-- 4. HABILITAR ROW LEVEL SECURITY (RLS)
ALTER TABLE public.administradores ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.tareas ENABLE ROW LEVEL SECURITY;


-- 5. CONFIGURAR POLÍTICAS DE ACCESO (SECURITY POLICIES)

-- Eliminar políticas previas si ya existían para evitar conflictos
DROP POLICY IF EXISTS "Permitir lectura de administradores" ON public.administradores;
DROP POLICY IF EXISTS "Permitir lectura publica de tareas" ON public.tareas;
DROP POLICY IF EXISTS "Permitir insercion publica de tareas" ON public.tareas;
DROP POLICY IF EXISTS "Permitir actualizacion publica de tareas" ON public.tareas;
DROP POLICY IF EXISTS "Permitir eliminacion publica de tareas" ON public.tareas;

-- Política para que la app web pueda consultar las credenciales y roles
CREATE POLICY "Permitir lectura de administradores" ON public.administradores 
FOR SELECT USING (true);

-- Políticas para la gestión libre de tareas desde la app web (lectura, inserción, actualización, eliminación)
CREATE POLICY "Permitir lectura publica de tareas" ON public.tareas 
FOR SELECT USING (true);

CREATE POLICY "Permitir insercion publica de tareas" ON public.tareas 
FOR INSERT WITH CHECK (true);

CREATE POLICY "Permitir actualizacion publica de tareas" ON public.tareas 
FOR UPDATE USING (true);

CREATE POLICY "Permitir eliminacion publica de tareas" ON public.tareas 
FOR DELETE USING (true);
